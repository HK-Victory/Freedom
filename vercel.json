{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "h5-app/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 1 * * *"
    }
  ],
  "env": {
    "NODE_VERSION": "20.x"
  }
}
