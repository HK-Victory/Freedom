{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "h5-app/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/xlsx/**,node_modules/@supabase/**,node_modules/sql.js/**"
    }
  },
  "env": {
    "NODE_VERSION": "20.x"
  }
}
